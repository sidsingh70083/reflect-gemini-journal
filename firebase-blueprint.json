{
  "entities": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile document storing personal preferences and metadata",
      "fields": {
        "uid": { "type": "string", "description": "Unique user identifier" },
        "displayName": { "type": "string", "description": "Display name of the user" },
        "email": { "type": "string", "description": "User email address" },
        "photoURL": { "type": "string", "description": "Profile picture URL" },
        "updatedAt": { "type": "timestamp", "description": "Last updated timestamp" }
      },
      "subcollections": {
        "entries": {
          "path": "users/{userId}/entries/{entryId}",
          "description": "Mindful journal session reflections and transcripts",
          "fields": {
            "messages": { "type": "array", "description": "User and AI dialogue messages" },
            "summary": { "type": "string", "description": "Emotional synthesis summary" },
            "aiCategory": { "type": "string", "description": "Gemini predicted mood category" },
            "userCategory": { "type": "string", "description": "User chosen or confirmed category" },
            "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
            "createdAtMillis": { "type": "number", "description": "Unix timestamp in milliseconds" },
            "streakCount": { "type": "number", "description": "Consecutive days journaling streak" },
            "nextDayCommitment": { "type": "string", "description": "Micro-commitment for the following day" },
            "commitmentCheckin": { "type": "object", "description": "Follow-up check-in status" },
            "location": { "type": "object", "description": "Geotag location coordinates and place name" }
          }
        },
        "letters": {
          "path": "users/{userId}/letters/{letterId}",
          "description": "Time-capsule letters written to future self",
          "fields": {
            "content": { "type": "string", "description": "Letter text body" },
            "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
            "createdAtMillis": { "type": "number", "description": "Unix timestamp in milliseconds" },
            "scheduledDate": { "type": "string", "description": "Unlock date formatted as YYYY-MM-DD" },
            "scheduledMillis": { "type": "number", "description": "Target unlock date in milliseconds" },
            "unlocked": { "type": "boolean", "description": "Whether the letter has unlocked" },
            "unlockedAtMillis": { "type": "number", "description": "Timestamp when unlocked" },
            "reflectionPrompt": { "type": "string", "description": "Retrospective prompt upon unlocking" }
          }
        },
        "digests": {
          "path": "users/{userId}/digests/{digestId}",
          "description": "Weekly retrospective digests generated by Gemini",
          "fields": {
            "createdAt": { "type": "timestamp", "description": "Creation timestamp" },
            "createdAtMillis": { "type": "number", "description": "Unix timestamp in milliseconds" },
            "dateRange": { "type": "object", "description": "Start and end dates of the week" },
            "entryCount": { "type": "number", "description": "Number of reflections in the digest" },
            "title": { "type": "string", "description": "Weekly theme title" },
            "themes": { "type": "array", "description": "Dominant emotional patterns" },
            "moodShift": { "type": "string", "description": "Weekly trajectory and shifts" },
            "categoryBreakdown": { "type": "object", "description": "Frequency count of mood categories" },
            "observations": { "type": "array", "description": "Gentle observations" },
            "encouragement": { "type": "string", "description": "Closing grounding affirmation" }
          }
        }
      }
    }
  }
}
